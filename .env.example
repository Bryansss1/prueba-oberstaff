# =============================================================================
#  bingo-sockets - variables de entorno
# =============================================================================
#  Copiá este archivo como `.env` y completá los valores.
#
#  IMPORTANTE (.env NO es JSON):
#    - NO usar comas finales ni comillas envolventes.
#    - `KEYCLOAK_ENABLED=true,` se lee literalmente "true," y desactiva
#      Keycloak en silencio.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL) - REQUERIDA
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database


# -----------------------------------------------------------------------------
# JWT legacy - REQUERIDA
# -----------------------------------------------------------------------------
# Secreto HS256 compartido con el backend web. Sin esto el servidor no arranca.
SECRET_KEY=change-me


# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=4000
VERSION=v1
URL=localhost:3000
SOCKET_PATH=/socket.io/


# -----------------------------------------------------------------------------
# Bingo
# -----------------------------------------------------------------------------
# Modo del bingo: REAL (termina 5 min después de cantar 75 números) o
# PRUEBA (solo termina con ganador)
BINGO_MODE=PRUEBA
AUTO_START_ENABLED=false
BINGO_START_TIME=09:00
BINGO_TIMEZONE=America/Caracas
SCHEDULER_INTERVAL=1


# -----------------------------------------------------------------------------
# Keycloak (dual-auth) - OPCIONAL
# -----------------------------------------------------------------------------
# Verifica access tokens RS256 de Keycloak contra el JWKS público del realm.
# Si KEYCLOAK_ENABLED está ausente o es distinto de "true", el servidor valida
# únicamente JWT legacy (comportamiento anterior).
#
# NO lleva secreto de service account: sockets sólo valida tokens, nunca
# administra usuarios en Keycloak.
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER=https://auth.boutique.conecaideal.com/realms/ideal
KEYCLOAK_CLIENT_ID=bingo-app
KEYCLOAK_JWKS_URI=https://auth.boutique.conecaideal.com/realms/ideal/protocol/openid-connect/certs
